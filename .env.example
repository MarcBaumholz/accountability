# ---------------------------------------------------------------------------
# Produktion. Auf dem Pi steht in /home/pi/apps/accountability/.env NUR diese
# eine Zeile — deploy/deploy-pi.sh überträgt genau sie und nichts sonst.
# ---------------------------------------------------------------------------

# Die zwei Personen. Genau zwei, Format "email:Name", mit Komma getrennt.
#
# Die Adressen müssen exakt denen entsprechen, die in der Cloudflare-Access-
# Policy erlaubt sind — Access liefert die Identität, diese Liste ist die
# zweite Tür dahinter. Wer in Access erlaubt ist, hier aber fehlt, kommt nicht
# hinein.
ACC_PEOPLE="marc@example.com:Marc,chris@example.com:Chris"

# ---------------------------------------------------------------------------
# NUR LOKAL. Diese Zeile darf NICHT auf den Pi.
# ---------------------------------------------------------------------------

# Ersatz für den Access-Header in der Entwicklung. Wirkt ausschließlich, wenn
# NODE_ENV "development" oder "test" ist; im Container steht NODE_ENV auf
# "production", die Variable wäre dort also wirkungslos. Trotzdem gehört sie
# nicht dorthin: eine schlafende Möglichkeit, ohne Anmeldung hereinzukommen, hat
# auf einer von außen erreichbaren Maschine nichts zu suchen.
DEV_USER_EMAIL="marc@example.com"

# Pfad der SQLite-Datei — lokal relativ zum Projekt. Im Container setzt
# docker-compose.yml stattdessen /app/data/accountability.db, also das
# gemountete Volume. Ein Pfad in einer Image-Schicht würde bei jedem Redeploy
# alle Daten löschen.
ACC_DB_PATH="./data/accountability.db"
